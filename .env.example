# Special Agent - Environment Secrets Example
# Copy this file to .env and fill in your actual credentials

# 1. OpenRouter API Key (Nous Hermes 3 70B Pitch Engine)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_MODEL=nousresearch/hermes-3-llama-3.1-70b

# 2. Telegram Bot Gateway (@Jubayer_agent_bot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-numeric-chat-id-here

# 3. Gmail SMTP Dispatcher (Optional: for sending direct outreach)
GMAIL_USER=jubayerahmadaistudio@gmail.com
GMAIL_APP_PASSWORD=your-16-char-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
