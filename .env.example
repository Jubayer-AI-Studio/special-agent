# Special Agent - Configuration Settings

# 1. Telegram Bot Gateway (Required for Mobile Remote Control)
# Get your token from Telegram by chatting with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Intelligence & Brain Layer (Nous Hermes 3 / LLM)
# Can be OpenRouter, Nous API, DeepSeek, or local Ollama
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nousresearch/hermes-3-llama-3.1-8b

# 3. Radar Scanning Settings
SCAN_INTERVAL_SECONDS=300
MIN_BUDGET_BDT=3000
MIN_BUDGET_USD=30
